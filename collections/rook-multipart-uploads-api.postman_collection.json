      "item": [
        {
          "id": "b58a8cfc-15cd-4878-a6a0-bb4a29ea04c2",
          "name": "List In-Progress Multipart Uploads",
          "request": {
            "name": "List In-Progress Multipart Uploads",
            "description": {
              "content": "Returns a list of in-progress multipart uploads for the specified bucket. Useful for identifying and cleaning up incomplete multipart uploads that may be consuming storage quota.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "{{bucket}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "uploads",
                  "value": "null"
                },
                {
                  "disabled": false,
                  "key": "uploads",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ],
              "variable": [
                {
                  "description": "Kubernetes Service hostname for the RGW endpoint as created by the CephObjectStore CRD. Format is rook-ceph-rgw-{store-name}.{namespace}.svc",
                  "type": "any",
                  "value": "{{rgw-host}}",
                  "key": "rgw-host"
                },
                {
                  "description": "Port for the RGW service, typically 80 for HTTP or 443 for HTTPS as configured in the CephObjectStore gateway spec",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
