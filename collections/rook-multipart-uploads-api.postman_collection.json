        {
          "id": "adcd32cd-e5ea-4919-b72c-901a502e1cce",
          "name": "Initiate a Multipart Upload",
          "request": {
            "name": "Initiate a Multipart Upload",
            "description": {
              "content": "Initiates a multipart upload for a large object and returns an upload ID that must be used in subsequent part upload and complete requests. Parts can then be uploaded in parallel using the upload ID. The multipart upload is not visible in the bucket until it is completed with a CompleteMultipartUpload request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":bucket",
                "{{key}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "uploads",
                  "value": "null"
                },
                {
                  "disabled": false,
                  "key": "uploads",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "bucket",
                  "description": "(Required) Name of the S3 bucket in the Ceph Object Storage gateway. Must be globally unique within the object store and follow DNS naming conventions."
                },
                {
                  "description": "Kubernetes Service hostname for the RGW endpoint as created by the CephObjectStore CRD. Format is rook-ceph-rgw-{store-name}.{namespace}.svc",
                  "type": "any",
                  "value": "{{rgw-host}}",
                  "key": "rgw-host"
                },
                {
                  "description": "Port for the RGW service, typically 80 for HTTP or 443 for HTTPS as configured in the CephObjectStore gateway spec",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "POST",
            "auth": null
          },
