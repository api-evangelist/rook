  "info": {
    "_postman_id": "77b86f57-f142-427e-9553-e84e06f8619e",
    "name": "Rook Ceph Object Storage Buckets Multipart Uploads API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Rook provisions Ceph Object Storage gateways (Ceph RADOS Gateway / RGW) that expose an S3-compatible REST API for object storage operations. The gateway is managed through Rook CephObjectStore and CephObjectStoreUser Kubernetes CRDs. Applications interact with the object storage using standard S3 API semantics including bucket operations, object CRUD, multipart uploads, access control lists, and presigned URLs. User credentials are provisioned via CephObjectStoreUser CRDs and accessed through Kubernetes Secrets.\n\nContact Support:\n Name: Rook Community",
      "type": "text/plain"
    }
  }
